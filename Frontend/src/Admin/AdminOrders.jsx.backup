import React, { useEffect, useMemo, useState } from "react";

import {
  ShoppingBag,
  Clock3,
  CheckCircle2,
  Truck,
  PackageCheck,
  XCircle,
  IndianRupee,
  Search,
  RefreshCw,
  Eye,
  ChevronRight,
  X,
  User,
  Mail,
  Phone,
  MapPin,
  CreditCard,
  CalendarDays,
  Hash,
  Box,
  Loader2,
  ChevronDown,
  FileSpreadsheet,
} from "lucide-react";

import Swal from "sweetalert2";
import { useSearchParams } from "react-router-dom";
import * as XLSX from "xlsx-js-style";

import AdminLayout from "./AdminLayout";
import api_base from "../apibase";

// =====================================================
// HELPERS
// =====================================================

const formatPrice = (value) => {
  const number = Number(value || 0);

  return `₹${number.toLocaleString("en-IN", {
    minimumFractionDigits: 2,
    maximumFractionDigits: 2,
  })}`;
};

const formatDate = (value) => {
  if (!value) return "—";

  const date = new Date(value);

  if (Number.isNaN(date.getTime())) {
    return "—";
  }

  return date.toLocaleDateString("en-IN", {
    day: "2-digit",
    month: "short",
    year: "numeric",
  });
};

const formatDateTime = (value) => {
  if (!value) return "—";

  const date = new Date(value);

  if (Number.isNaN(date.getTime())) {
    return "—";
  }

  return date.toLocaleString("en-IN", {
    day: "2-digit",
    month: "short",
    year: "numeric",
    hour: "2-digit",
    minute: "2-digit",
  });
};

// =====================================================
// EXCEL EXPORT
// =====================================================

const exportOrdersToExcel = (orders, returnRequests) => {
  try {
    const workbook = XLSX.utils.book_new();

    const exportDate = new Date();
    const fileDate = exportDate.toISOString().slice(0, 10);

    const headerStyle = {
      fill: { fgColor: { rgb: "F5A524" } },
      font: { bold: true, color: { rgb: "111827" }, sz: 11 },
      alignment: { horizontal: "center", vertical: "center", wrapText: true },
      border: {
        top: { style: "thin", color: { rgb: "D1D5DB" } },
        bottom: { style: "thin", color: { rgb: "D1D5DB" } },
        left: { style: "thin", color: { rgb: "D1D5DB" } },
        right: { style: "thin", color: { rgb: "D1D5DB" } },
      },
    };

    const titleStyle = {
      fill: { fgColor: { rgb: "111827" } },
      font: { bold: true, color: { rgb: "FFFFFF" }, sz: 15 },
      alignment: { horizontal: "left", vertical: "center" },
    };

    const sectionStyle = {
      fill: { fgColor: { rgb: "E5E7EB" } },
      font: { bold: true, color: { rgb: "111827" }, sz: 11 },
      alignment: { vertical: "center" },
    };

    const borderStyle = {
      top: { style: "thin", color: { rgb: "E5E7EB" } },
      bottom: { style: "thin", color: { rgb: "E5E7EB" } },
      left: { style: "thin", color: { rgb: "E5E7EB" } },
      right: { style: "thin", color: { rgb: "E5E7EB" } },
    };

    const applySheetStyle = (sheet, headerRow, columnWidths) => {
      const range = XLSX.utils.decode_range(sheet["!ref"]);

      for (let row = range.s.r; row <= range.e.r; row += 1) {
        for (let col = range.s.c; col <= range.e.c; col += 1) {
          const address = XLSX.utils.encode_cell({ r: row, c: col });
          const cell = sheet[address];

          if (!cell) {
            continue;
          }

          cell.s = {
            border: borderStyle,
            alignment: {
              vertical: "center",
              wrapText: true,
            },
          };

          if (row === headerRow) {
            cell.s = {
              ...cell.s,
              ...headerStyle,
            };
          }
        }
      }

      sheet["!cols"] = columnWidths.map((wch) => ({ wch }));
      sheet["!freeze"] = { xSplit: 0, ySplit: headerRow + 1 };
      sheet["!autofilter"] = {
        ref: XLSX.utils.encode_range({
          s: { r: headerRow, c: range.s.c },
          e: { r: headerRow, c: range.e.c },
        }),
      };
    };

    const addTitle = (sheet, title, lastColumn) => {
      const titleCell = sheet["A1"];

      if (titleCell) {
        titleCell.s = titleStyle;
      }

      sheet["!merges"] = [
        {
          s: { r: 0, c: 0 },
          e: { r: 0, c: lastColumn },
        },
      ];

      sheet["!rows"] = [{ hpt: 25 }];
    };

    // =====================================================
    // SUMMARY SHEET
    // =====================================================

    const totalRevenue = orders.reduce(
      (sum, order) => sum + Number(order.total_amount || 0),
      0
    );

    const paidOrders = orders.filter(
      (order) => String(order.payment_status || "").toLowerCase() === "paid"
    ).length;

    const codOrders = orders.filter(
      (order) => String(order.payment_method || "").toUpperCase() === "COD"
    ).length;

    const onlineOrders = orders.filter(
      (order) => String(order.payment_method || "").toUpperCase() !== "COD"
    ).length;

    const refundedReturns = returnRequests.filter(
      (item) =>
        String(item.status || "").toLowerCase() === "refunded" ||
        Boolean(item.refund_amount) ||
        Boolean(item.razorpay_refund_id) ||
        Boolean(item.refund_reference)
    );

    const totalRefunded = returnRequests.reduce(
      (sum, item) =>
        sum +
        Number(
          item.refund_amount ??
            item.refunded_amount ??
            (item.status === "Refunded"
              ? item.order_amount ?? item.total_amount
              : 0) ??
            0
        ),
      0
    );

    const summaryRows = [
      ["ShopNest - Orders & Refund Report"],
      ["Report Generated", formatDateTime(exportDate.toISOString())],
      [],
      ["ORDER SUMMARY"],
      ["Total Orders", orders.length],
      ["Paid Orders", paidOrders],
      ["COD Orders", codOrders],
      ["Online Payment Orders", onlineOrders],
      ["Total Order Value", totalRevenue],
      [],
      ["RETURN / REFUND SUMMARY"],
      ["Total Return Requests", returnRequests.length],
      ["Refunded Returns", refundedReturns.length],
      ["Total Refunded Amount", totalRefunded],
    ];

    const summarySheet = XLSX.utils.aoa_to_sheet(summaryRows);

    addTitle(summarySheet, "ShopNest - Orders & Refund Report", 1);

    summarySheet["A4"].s = sectionStyle;
    summarySheet["A11"].s = sectionStyle;

    summarySheet["A9"].z = "₹#,##0.00";
    summarySheet["B9"].z = "₹#,##0.00";
    summarySheet["B9"].s = {
      border: borderStyle,
      font: { bold: true },
      numFmt: "₹#,##0.00",
    };

    summarySheet["B14"].z = "₹#,##0.00";
    summarySheet["B14"].s = {
      border: borderStyle,
      font: { bold: true },
      numFmt: "₹#,##0.00",
    };

    summarySheet["!cols"] = [{ wch: 30 }, { wch: 28 }];
    summarySheet["!rows"] = [
      { hpt: 25 },
      { hpt: 20 },
      { hpt: 8 },
      { hpt: 22 },
    ];

    for (let row = 0; row < summaryRows.length; row += 1) {
      for (let col = 0; col < 2; col += 1) {
        const address = XLSX.utils.encode_cell({ r: row, c: col });
        const cell = summarySheet[address];

        if (!cell) {
          continue;
        }

        if (!cell.s) {
          cell.s = {
            border: borderStyle,
            alignment: {
              vertical: "center",
              wrapText: true,
            },
          };
        }
      }
    }

    XLSX.utils.book_append_sheet(workbook, summarySheet, "Summary");

    // =====================================================
    // ORDERS SHEET
    // =====================================================

    const orderRows = [
      ["ShopNest - All Orders"],
      [],
      [
        "Order ID",
        "Order Number",
        "Customer Name",
        "Customer Email",
        "Customer Mobile",
        "Payment Method",
        "Payment Status",
        "Payment Reference",
        "Paid At",
        "Order Status",
        "Subtotal",
        "Shipping Charge",
        "Total Amount",
        "Address",
        "City",
        "State",
        "Pincode",
        "Address Type",
        "Created At",
        "Updated At",
        "Item Count",
      ],
    ];

    orders.forEach((order) => {
      const customerName =
        order.customer?.name ||
        order.address?.full_name ||
        "Unknown Customer";

      const customerEmail = order.customer?.email || "—";

      const customerMobile =
        order.customer?.mobile ||
        order.address?.mobile ||
        "—";

      const itemCount =
        order.items?.reduce(
          (sum, item) => sum + Number(item.quantity || 0),
          0
        ) || 0;

      const addressParts = [
        order.address?.house,
        order.address?.area,
        order.address?.city,
        order.address?.state,
        order.address?.pincode,
      ].filter(Boolean);

      orderRows.push([
        order.id ?? "",
        order.order_number || `ORD-${order.id}`,
        customerName,
        customerEmail,
        customerMobile,
        order.payment_method || "—",
        order.payment_status || "Pending",
        order.payment_reference || "—",
        order.paid_at ? formatDateTime(order.paid_at) : "—",
        order.order_status || "—",
        Number(order.subtotal || 0),
        Number(order.shipping_charge || 0),
        Number(order.total_amount || 0),
        addressParts.join(", ") || "—",
        order.address?.city || "—",
        order.address?.state || "—",
        order.address?.pincode || "—",
        order.address?.address_type || "—",
        formatDateTime(order.created_at),
        formatDateTime(order.updated_at),
        itemCount,
      ]);
    });

    const ordersSheet = XLSX.utils.aoa_to_sheet(orderRows);

    addTitle(ordersSheet, "ShopNest - All Orders", 20);
    applySheetStyle(
      ordersSheet,
      2,
      [
        10,
        24,
        24,
        30,
        17,
        16,
        16,
        25,
        22,
        16,
        15,
        17,
        16,
        45,
        18,
        18,
        12,
        16,
        22,
        22,
        12,
      ]
    );

    for (let row = 3; row < orderRows.length; row += 1) {
      ["K", "L", "M"].forEach((column) => {
        const cell = ordersSheet[`${column}${row + 1}`];

        if (cell) {
          cell.z = "₹#,##0.00";
          cell.s = {
            ...cell.s,
            numFmt: "₹#,##0.00",
          };
        }
      });
    }

    XLSX.utils.book_append_sheet(workbook, ordersSheet, "Orders");

    // =====================================================
    // ORDER ITEMS SHEET
    // =====================================================

    const itemRows = [
      ["ShopNest - Order Items"],
      [],
      [
        "Order ID",
        "Order Number",
        "Customer Name",
        "Product ID",
        "Product Name",
        "Size",
        "Price",
        "Quantity",
        "Item Total",
        "Payment Method",
        "Order Status",
        "Order Date",
      ],
    ];

    orders.forEach((order) => {
      const customerName =
        order.customer?.name ||
        order.address?.full_name ||
        "Unknown Customer";

      (order.items || []).forEach((item) => {
        itemRows.push([
          order.id ?? "",
          order.order_number || `ORD-${order.id}`,
          customerName,
          item.product_id ?? "",
          item.product_name || "Product",
          item.size || "—",
          Number(item.price || 0),
          Number(item.quantity || 0),
          Number(item.total || 0),
          order.payment_method || "—",
          order.order_status || "—",
          formatDateTime(order.created_at),
        ]);
      });
    });

    const itemsSheet = XLSX.utils.aoa_to_sheet(itemRows);

    addTitle(itemsSheet, "ShopNest - Order Items", 11);
    applySheetStyle(
      itemsSheet,
      2,
      [10, 24, 24, 12, 30, 12, 15, 12, 16, 16, 16, 22]
    );

    for (let row = 3; row < itemRows.length; row += 1) {
      ["G", "I"].forEach((column) => {
        const cell = itemsSheet[`${column}${row + 1}`];

        if (cell) {
          cell.z = "₹#,##0.00";
          cell.s = {
            ...cell.s,
            numFmt: "₹#,##0.00",
          };
        }
      });
    }

    XLSX.utils.book_append_sheet(workbook, itemsSheet, "Order Items");

    // =====================================================
    // RETURNS & REFUNDS SHEET
    // =====================================================

    const refundRows = [
      ["ShopNest - Returns & Refunds"],
      [],
      [
        "Return ID",
        "Order ID",
        "Order Number",
        "Customer Name",
        "Customer Mobile",
        "Reason",
        "Description",
        "Payment Method",
        "Order Amount",
        "Refund Amount",
        "Refund Method",
        "Refund Reference",
        "Razorpay Refund ID",
        "Refund Status",
        "Return Status",
        "Requested At",
        "Updated At",
      ],
    ];

    returnRequests.forEach((item) => {
      const customerName =
        item.customer_name ||
        item.customer?.name ||
        item.address?.full_name ||
        "Unknown Customer";

      const customerMobile =
        item.customer_mobile ||
        item.customer?.mobile ||
        item.address?.mobile ||
        "—";

      const refundAmount =
        item.refund_amount ??
        item.refunded_amount ??
        "";

      const refundStatus =
        item.refund_status ||
        (item.razorpay_refund_id || item.refund_reference
          ? "Refunded"
          : "Not Refunded");

      refundRows.push([
        item.id ?? "",
        item.order_id ?? "",
        item.order_number || `ORD-${item.order_id || ""}`,
        customerName,
        customerMobile,
        item.reason || "—",
        item.description || "—",
        item.payment_method || "—",
        Number(item.order_amount ?? item.total_amount ?? 0),
        refundAmount === "" ? "" : Number(refundAmount || 0),
        item.refund_method || "—",
        item.refund_reference || "—",
        item.razorpay_refund_id || "—",
        refundStatus,
        item.status || "Requested",
        item.created_at ? formatDateTime(item.created_at) : "—",
        item.updated_at ? formatDateTime(item.updated_at) : "—",
      ]);
    });

    const refundsSheet = XLSX.utils.aoa_to_sheet(refundRows);

    addTitle(refundsSheet, "ShopNest - Returns & Refunds", 16);
    applySheetStyle(
      refundsSheet,
      2,
      [
        12,
        12,
        24,
        24,
        17,
        22,
        45,
        16,
        17,
        17,
        16,
        28,
        28,
        18,
        20,
        22,
        22,
      ]
    );

    for (let row = 3; row < refundRows.length; row += 1) {
      ["I", "J"].forEach((column) => {
        const cell = refundsSheet[`${column}${row + 1}`];

        if (cell) {
          cell.z = "₹#,##0.00";
          cell.s = {
            ...cell.s,
            numFmt: "₹#,##0.00",
          };
        }
      });
    }

    XLSX.utils.book_append_sheet(
      workbook,
      refundsSheet,
      "Returns & Refunds"
    );

    // =====================================================
    // DOWNLOAD
    // =====================================================

    XLSX.writeFile(
      workbook,
      `ShopNest_Orders_Refunds_${fileDate}.xlsx`
    );
  } catch (error) {
    console.error("Excel Export Error:", error);

    Swal.fire({
      title: "Export Failed",
      text: error.message || "Unable to export Excel file.",
      icon: "error",
      background: "#151B2B",
      color: "#fff",
      confirmButtonColor: "#F5A524",
    });
  }
};

// =====================================================
// STATUS STYLE
// =====================================================

const getStatusStyle = (status) => {
  switch (status) {
    case "Pending":
      return {
        wrapper: "bg-amber-500/10 text-amber-400 border-amber-500/20",
        icon: Clock3,
      };

    case "Confirmed":
      return {
        wrapper: "bg-cyan-500/10 text-cyan-400 border-cyan-500/20",
        icon: CheckCircle2,
      };

    case "Shipped":
      return {
        wrapper: "bg-blue-500/10 text-blue-400 border-blue-500/20",
        icon: Truck,
      };

    case "Out for Delivery":
      return {
        wrapper: "bg-violet-500/10 text-violet-400 border-violet-500/20",
        icon: Truck,
      };

    case "Delivered":
      return {
        wrapper: "bg-emerald-500/10 text-emerald-400 border-emerald-500/20",
        icon: PackageCheck,
      };

    case "Cancelled":
      return {
        wrapper: "bg-red-500/10 text-red-400 border-red-500/20",
        icon: XCircle,
      };

    default:
      return {
        wrapper: "bg-gray-500/10 text-gray-400 border-gray-500/20",
        icon: Clock3,
      };
  }
};

// =====================================================
// STATUS BADGE
// =====================================================

function StatusBadge({ status }) {
  const style = getStatusStyle(status);
  const Icon = style.icon;

  return (
    <span
      className={`
        inline-flex
        items-center
        gap-1.5
        px-2.5
        py-1.5
        rounded-lg
        border
        text-xs
        font-semibold
        whitespace-nowrap
        ${style.wrapper}
      `}
    >
      <Icon size={13} />
      {status || "Unknown"}
    </span>
  );
}

// =====================================================
// STAT CARD
// =====================================================

function StatCard({
  label,
  value,
  description,
  icon: Icon,
  accent,
}) {
  return (
    <div
      className="
        relative
        overflow-hidden
        rounded-2xl
        border
        border-white/[0.06]
        bg-white/[0.03]
        p-5
        transition
        duration-300
        hover:-translate-y-0.5
        hover:border-white/[0.10]
      "
    >
      <div
        className="
          absolute
          -right-8
          -top-8
          w-24
          h-24
          rounded-full
          blur-3xl
          opacity-20
        "
        style={{
          backgroundColor: accent,
        }}
      />

      <div className="relative flex items-start justify-between">
        <div>
          <p className="text-xs font-medium text-slate-500">
            {label}
          </p>

          <p className="mt-2 text-2xl font-bold tracking-tight text-white">
            {value}
          </p>

          <p className="mt-1 text-[11px] text-slate-600">
            {description}
          </p>
        </div>

        <div
          className="
            w-11
            h-11
            rounded-xl
            flex
            items-center
            justify-center
          "
          style={{
            backgroundColor: `${accent}18`,
            color: accent,
          }}
        >
          <Icon size={20} />
        </div>
      </div>
    </div>
  );
}

// =====================================================
// MAIN COMPONENT
// =====================================================

export default function AdminOrders({ darkMode = true }) {
  const [orders, setOrders] = useState([]);

  const [summary, setSummary] = useState({
    total_orders: 0,
    pending: 0,
    confirmed: 0,
    shipped: 0,
    out_for_delivery: 0,
    delivered: 0,
    cancelled: 0,
  });

  const [loading, setLoading] = useState(true);
  const [refreshing, setRefreshing] = useState(false);

  const [search, setSearch] = useState("");

  const [statusFilter, setStatusFilter] =
    useState("All Status");

  const [paymentFilter, setPaymentFilter] =
    useState("All Payments");

  const [selectedOrder, setSelectedOrder] =
    useState(null);

  const [searchParams] = useSearchParams();
  const orderId = searchParams.get("order");

  const [updatingStatus, setUpdatingStatus] =
    useState(false);

  const [returnRequests, setReturnRequests] = useState([]);
  const [returnLoading, setReturnLoading] = useState(false);
  const [returnActionLoading, setReturnActionLoading] = useState(false);

  // =====================================================
  // FETCH ORDERS
  // =====================================================

  const fetchOrders = async (showLoader = true) => {
    try {
      if (showLoader) {
        setLoading(true);
      } else {
        setRefreshing(true);
      }

      const response = await fetch(
        `${api_base}admin-orders/`,
        {
          method: "GET",
          credentials: "include",
        }
      );

      const data = await response.json();

      if (!response.ok) {
        throw new Error(
          data.msg || "Failed to load orders"
        );
      }

      const loadedOrders = data.orders || [];

      setOrders(loadedOrders);

      setSummary(
        data.summary || {
          total_orders: 0,
          pending: 0,
          confirmed: 0,
          shipped: 0,
          out_for_delivery: 0,
          delivered: 0,
          cancelled: 0,
        }
      );
    } catch (error) {
      console.error("Admin Orders Error:", error);

      Swal.fire({
        title: "Unable to load orders",
        text:
          error.message ||
          "Something went wrong",
        icon: "error",
        background: "#151B2B",
        color: "#fff",
        confirmButtonColor: "#F5A524",
      });
    } finally {
      setLoading(false);
      setRefreshing(false);
    }
  };

  // =====================================================
  // OPEN ORDER FROM GLOBAL ADMIN SEARCH
  // =====================================================

  useEffect(() => {
    if (!orderId || orders.length === 0) {
      return;
    }

    const order = orders.find(
      (item) => String(item.id) === String(orderId)
    );

    if (order) {
      setSelectedOrder(order);
    }
  }, [orderId, orders]);

  // =====================================================
  // FETCH RETURN REQUESTS
  // =====================================================

  const fetchReturnRequests = async () => {
    try {
      setReturnLoading(true);

      const response = await fetch(`${api_base}admin-returns/`, {
        method: "GET",
        credentials: "include",
      });

      const data = await response.json();

      if (!response.ok) {
        throw new Error(data.msg || "Failed to load return requests");
      }

      setReturnRequests(data.returns || []);
    } catch (error) {
      console.error("Return Requests Error:", error);

      Swal.fire({
        title: "Unable to load returns",
        text: error.message || "Something went wrong",
        icon: "error",
        background: "#151B2B",
        color: "#fff",
        confirmButtonColor: "#F5A524",
      });
    } finally {
      setReturnLoading(false);
    }
  };

  // =====================================================
  // UPDATE RETURN STATUS
  // =====================================================

  const handleReturnStatusUpdate = async (returnId, newStatus) => {
    try {
      setReturnActionLoading(true);

      const response = await fetch(`${api_base}admin/returns/${returnId}/`, {
        method: "PATCH",
        credentials: "include",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ status: newStatus }),
      });

      const data = await response.json();

      if (!response.ok) {
        throw new Error(data.msg || "Failed to update return status");
      }

      setReturnRequests((prev) =>
        prev.map((item) =>
          item.id === returnId ? { ...item, status: newStatus } : item
        )
      );

      Swal.fire({
        title: "Status Updated",
        text: data.msg || `Return status changed to ${newStatus}`,
        icon: "success",
        timer: 1400,
        showConfirmButton: false,
        background: "#151B2B",
        color: "#fff",
      });

      fetchReturnRequests();
    } catch (error) {
      Swal.fire({
        title: "Update Failed",
        text: error.message || "Unable to update return",
        icon: "error",
        background: "#151B2B",
        color: "#fff",
        confirmButtonColor: "#F5A524",
      });
    } finally {
      setReturnActionLoading(false);
    }
  };

  // =====================================================
  // MARK PRODUCT RECEIVED
  // =====================================================

  const handleProductReceived = async (returnId) => {
    const result = await Swal.fire({
      title: "Product Received?",
      text: "Confirm that the returned product has been received.",
      icon: "question",
      showCancelButton: true,
      confirmButtonText: "Yes, Received",
      cancelButtonText: "Cancel",
      confirmButtonColor: "#22C55E",
      cancelButtonColor: "#374151",
      background: "#151B2B",
      color: "#fff",
    });

    if (!result.isConfirmed) return;

    try {
      setReturnActionLoading(true);

      const response = await fetch(`${api_base}admin/returns/${returnId}/received/`, {
        method: "PATCH",
        credentials: "include",
      });

      const data = await response.json();

      if (!response.ok) {
        throw new Error(data.msg || "Failed to mark product received");
      }

      Swal.fire({
        title: "Product Received",
        text: data.msg || "Returned product marked as received",
        icon: "success",
        timer: 1500,
        showConfirmButton: false,
        background: "#151B2B",
        color: "#fff",
      });

      fetchReturnRequests();
    } catch (error) {
      Swal.fire({
        title: "Failed",
        text: error.message || "Unable to mark product received",
        icon: "error",
        background: "#151B2B",
        color: "#fff",
        confirmButtonColor: "#F5A524",
      });
    } finally {
      setReturnActionLoading(false);
    }
  };

  // =====================================================
  // PROCESS REFUND
  // =====================================================

  const handleRefund = async (returnRequest) => {
    const paymentMethod = (returnRequest.payment_method || "").toUpperCase();
    const isCOD = paymentMethod === "COD";
    let refundAmount = returnRequest.order_amount ?? returnRequest.total_amount;
    let refundMethod = "";
    let refundReference = "";

    if (isCOD) {
      const result = await Swal.fire({
        title: "COD Refund",
        html: `<div style="text-align:left"><label style="font-size:13px;font-weight:600">Refund Amount</label><input id="refund-amount" class="swal2-input" value="${refundAmount || ""}" placeholder="Refund amount"><label style="font-size:13px;font-weight:600">Refund Method</label><select id="refund-method" class="swal2-select"><option value="UPI">UPI</option><option value="BANK">BANK</option></select><label style="font-size:13px;font-weight:600">Refund Reference</label><input id="refund-reference" class="swal2-input" placeholder="UPI / Bank transaction reference"></div>`,
        showCancelButton: true,
        confirmButtonText: "Process Refund",
        cancelButtonText: "Cancel",
        confirmButtonColor: "#22C55E",
        cancelButtonColor: "#374151",
        background: "#151B2B",
        color: "#fff",
        preConfirm: () => {
          const amount = document.getElementById("refund-amount").value;
          refundMethod = document.getElementById("refund-method").value;
          refundReference = document.getElementById("refund-reference").value.trim();
          if (!amount) { Swal.showValidationMessage("Refund amount is required"); return false; }
          if (!refundReference) { Swal.showValidationMessage("Refund reference is required"); return false; }
          refundAmount = amount;
          return true;
        },
      });

      if (!result.isConfirmed) return;
    } else {
      const result = await Swal.fire({
        title: "Process Razorpay Refund?",
        text: `Refund ${formatPrice(refundAmount)} to the original payment.`,
        icon: "question",
        showCancelButton: true,
        confirmButtonText: "Process Refund",
        cancelButtonText: "Cancel",
        confirmButtonColor: "#22C55E",
        cancelButtonColor: "#374151",
        background: "#151B2B",
        color: "#fff",
      });

      if (!result.isConfirmed) return;
    }

    try {
      setReturnActionLoading(true);
      const body = { amount: refundAmount };

      if (isCOD) {
        body.refund_method = refundMethod;
        body.refund_reference = refundReference;
      }

      const response = await fetch(`${api_base}admin/returns/${returnRequest.id}/refund/`, {
        method: "POST",
        credentials: "include",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(body),
      });

      const data = await response.json();

      if (!response.ok) {
        throw new Error(data.msg || "Refund failed");
      }

      Swal.fire({
        title: "Refund Successful",
        text: data.msg || "Refund processed successfully",
        icon: "success",
        timer: 1800,
        showConfirmButton: false,
        background: "#151B2B",
        color: "#fff",
      });

      fetchReturnRequests();
    } catch (error) {
      Swal.fire({
        title: "Refund Failed",
        text: error.message || "Unable to process refund",
        icon: "error",
        background: "#151B2B",
        color: "#fff",
        confirmButtonColor: "#F5A524",
      });
    } finally {
      setReturnActionLoading(false);
    }
  };

  // =====================================================
  // INITIAL LOAD
  // =====================================================

  useEffect(() => {
    fetchOrders();
    fetchReturnRequests();
  }, []);

  // =====================================================
  // FILTER ORDERS
  // =====================================================

  const filteredOrders = useMemo(() => {
    const query = search.trim().toLowerCase();

    return orders.filter((order) => {
      const customerName =
        order.customer?.name ||
        order.address?.full_name ||
        "";

      const customerEmail =
        order.customer?.email || "";

      const customerMobile =
        order.customer?.mobile ||
        order.address?.mobile ||
        "";

      const orderNumber =
        order.order_number || "";

      const matchesSearch =
        !query ||
        orderNumber
          .toLowerCase()
          .includes(query) ||
        customerName
          .toLowerCase()
          .includes(query) ||
        customerEmail
          .toLowerCase()
          .includes(query) ||
        customerMobile
          .toLowerCase()
          .includes(query);

      const matchesStatus =
        statusFilter === "All Status" ||
        order.order_status === statusFilter;

      const matchesPayment =
        paymentFilter === "All Payments" ||
        order.payment_method === paymentFilter;

      return (
        matchesSearch &&
        matchesStatus &&
        matchesPayment
      );
    });
  }, [
    orders,
    search,
    statusFilter,
    paymentFilter,
  ]);

  // =====================================================
  // REVENUE
  // =====================================================

  const revenue = useMemo(() => {
    return orders.reduce(
      (total, order) =>
        total +
        Number(order.total_amount || 0),
      0
    );
  }, [orders]);

  // =====================================================
  // UPDATE STATUS
  // =====================================================

  const handleStatusUpdate = async (
    orderId,
    newStatus
  ) => {
    try {
      setUpdatingStatus(true);

      const response = await fetch(
        `${api_base}admin-orders/`,
        {
          method: "PATCH",
          credentials: "include",
          headers: {
            "Content-Type":
              "application/json",
          },
          body: JSON.stringify({
            order_id: orderId,
            order_status: newStatus,
          }),
        }
      );

      const data = await response.json();

      if (!response.ok) {
        throw new Error(
          data.msg ||
            "Failed to update order status"
        );
      }

      setOrders((prev) =>
        prev.map((order) =>
          order.id === orderId
            ? {
                ...order,
                order_status: newStatus,
              }
            : order
        )
      );

      setSelectedOrder((prev) =>
        prev && prev.id === orderId
          ? {
              ...prev,
              order_status: newStatus,
            }
          : prev
      );

      // Refresh summary
      fetchOrders(false);

      Swal.fire({
        title: "Status Updated",
        text: `Order status changed to ${newStatus}`,
        icon: "success",
        timer: 1400,
        showConfirmButton: false,
        background: "#151B2B",
        color: "#fff",
      });
    } catch (error) {
      console.error(
        "Status update error:",
        error
      );

      Swal.fire({
        title: "Update Failed",
        text:
          error.message ||
          "Unable to update order",
        icon: "error",
        background: "#151B2B",
        color: "#fff",
        confirmButtonColor: "#F5A524",
      });
    } finally {
      setUpdatingStatus(false);
    }
  };

  // =====================================================
  // LOADING
  // =====================================================

  if (loading) {
    return (
      <AdminLayout darkMode={darkMode}>
        <div
          className="
            min-h-screen
            bg-[#0B0F19]
            flex
            items-center
            justify-center
          "
        >
          <div className="text-center">
            <div
              className="
                w-12
                h-12
                rounded-full
                border-4
                border-[#F5A524]/20
                border-t-[#F5A524]
                animate-spin
                mx-auto
              "
            />

            <p className="mt-4 text-sm text-slate-500">
              Loading orders...
            </p>
          </div>
        </div>
      </AdminLayout>
    );
  }

  // =====================================================
  // PAGE
  // =====================================================

  return (
    <AdminLayout darkMode={darkMode}>
      <div
        className="
          min-h-screen
          bg-[#0B0F19]
          text-white
        "
      >
        {/* =================================================
            PAGE HEADER
        ================================================= */}

        <div
          className="
            border-b
            border-white/[0.06]
          "
        >
          <div
            className="
              max-w-[1600px]
              mx-auto
              px-4
              sm:px-6
              lg:px-8
              py-7
            "
          >
            <div
              className="
                flex
                flex-col
                sm:flex-row
                sm:items-center
                sm:justify-between
                gap-5
              "
            >
              <div>
                <div
                  className="
                    flex
                    items-center
                    gap-3
                  "
                >
                  <div
                    className="
                      w-11
                      h-11
                      rounded-xl
                      bg-[#F5A524]/10
                      border
                      border-[#F5A524]/20
                      flex
                      items-center
                      justify-center
                      text-[#F5A524]
                    "
                  >
                    <ShoppingBag size={21} />
                  </div>

                  <div>
                    <p
                      className="
                        text-[11px]
                        font-bold
                        tracking-[0.18em]
                        uppercase
                        text-[#F5A524]
                      "
                    >
                      Management
                    </p>

                    <h1
                      className="
                        text-2xl
                        sm:text-3xl
                        font-bold
                        tracking-tight
                        text-white
                      "
                    >
                      Orders
                    </h1>
                  </div>
                </div>

                <p
                  className="
                    mt-3
                    text-sm
                    text-slate-500
                    max-w-2xl
                  "
                >
                  Manage customer orders,
                  payments, delivery status
                  and order details from one
                  place.
                </p>
              </div>

              {/* REFRESH */}

              <button
                onClick={() => fetchOrders(false)}
                disabled={refreshing}
                className="
                  inline-flex
                  items-center
                  justify-center
                  gap-2
                  px-4
                  py-2.5
                  rounded-xl
                  border
                  border-white/[0.08]
                  bg-white/[0.03]
                  text-sm
                  font-semibold
                  text-slate-300
                  hover:bg-white/[0.06]
                  hover:text-white
                  transition
                  disabled:opacity-50
                  self-start
                  sm:self-auto
                "
              >
                <RefreshCw
                  size={16}
                  className={
                    refreshing
                      ? "animate-spin"
                      : ""
                  }
                />

                {refreshing
                  ? "Refreshing..."
                  : "Refresh"}
              </button>
            </div>
          </div>
        </div>

        {/* =================================================
            CONTENT
        ================================================= */}

        <main
          className="
            max-w-[1600px]
            mx-auto
            px-4
            sm:px-6
            lg:px-8
            py-6
            space-y-6
          "
        >
          {/* =================================================
              STAT CARDS
          ================================================= */}

          <div
            className="
              grid
              grid-cols-1
              sm:grid-cols-2
              xl:grid-cols-7
              gap-4
            "
          >
            <StatCard
              label="Total Orders"
              value={summary.total_orders}
              description="All customer orders"
              icon={ShoppingBag}
              accent="#3B82F6"
            />

            <StatCard
              label="Pending"
              value={summary.pending}
              description="Waiting for confirmation"
              icon={Clock3}
              accent="#F5A524"
            />

            <StatCard
              label="Confirmed"
              value={summary.confirmed}
              description="Orders confirmed"
              icon={CheckCircle2}
              accent="#22D3EE"
            />

            <StatCard
              label="Shipped"
              value={summary.shipped}
              description="Orders on the way"
              icon={Truck}
              accent="#3B82F6"
            />

            <StatCard
              label="Out for Delivery"
              value={summary.out_for_delivery}
              description="Ready for final delivery"
              icon={Truck}
              accent="#8B5CF6"
            />

            <StatCard
              label="Delivered"
              value={summary.delivered}
              description="Successfully delivered"
              icon={PackageCheck}
              accent="#34D399"
            />

            <StatCard
              label="Revenue"
              value={formatPrice(revenue)}
              description="Total order value"
              icon={IndianRupee}
              accent="#F5A524"
            />
          </div>

          {/* =================================================
              ORDERS CARD
          ================================================= */}

          <div
            className="
              rounded-2xl
              border
              border-white/[0.06]
              bg-white/[0.025]
              overflow-hidden
            "
          >
            {/* CARD HEADER */}

            <div
              className="
                p-5
                sm:p-6
                border-b
                border-white/[0.06]
              "
            >
              <div
                className="
                  flex
                  flex-col
                  xl:flex-row
                  xl:items-center
                  xl:justify-between
                  gap-4
                "
              >
                <div>
                  <h2
                    className="
                      text-lg
                      sm:text-xl
                      font-bold
                      text-white
                    "
                  >
                    All Orders
                  </h2>

                  <p
                    className="
                      text-xs
                      text-slate-500
                      mt-1
                    "
                  >
                    {filteredOrders.length} order
                    {filteredOrders.length !== 1
                      ? "s"
                      : ""}{" "}
                    found
                  </p>
                </div>

                {/* FILTERS */}

                <div
                  className="
                    flex
                    flex-col
                    sm:flex-row
                    gap-2
                    w-full
                    xl:w-auto
                  "
                >
                  {/* SEARCH */}

                  <div
                    className="
                      relative
                      w-full
                      sm:w-64
                    "
                  >
                    <Search
                      size={17}
                      className="
                        absolute
                        left-3
                        top-1/2
                        -translate-y-1/2
                        text-slate-600
                      "
                    />

                    <input
                      type="text"
                      value={search}
                      onChange={(e) =>
                        setSearch(e.target.value)
                      }
                      placeholder="Search orders..."
                      className="
                        w-full
                        h-11
                        rounded-xl
                        border
                        border-white/[0.08]
                        bg-[#0B0F19]
                        pl-10
                        pr-4
                        text-sm
                        text-white
                        placeholder:text-slate-600
                        outline-none
                        focus:border-[#F5A524]/40
                        transition
                      "
                    />
                  </div>

                  {/* STATUS */}

                  <div className="relative">
                    <select
                      value={statusFilter}
                      onChange={(e) =>
                        setStatusFilter(
                          e.target.value
                        )
                      }
                      className="
                        appearance-none
                        w-full
                        sm:w-40
                        h-11
                        rounded-xl
                        border
                        border-white/[0.08]
                        bg-[#0B0F19]
                        px-4
                        pr-9
                        text-sm
                        font-medium
                        text-slate-300
                        outline-none
                        focus:border-[#F5A524]/40
                        cursor-pointer
                      "
                    >
                      <option>All Status</option>
                      <option>Pending</option>
                      <option>Confirmed</option>
                      <option>Shipped</option>
                      <option>Out for Delivery</option>
                      <option>Delivered</option>
                      <option>Cancelled</option>
                    </select>

                    <ChevronDown
                      size={15}
                      className="
                        absolute
                        right-3
                        top-1/2
                        -translate-y-1/2
                        text-slate-600
                        pointer-events-none
                      "
                    />
                  </div>

                  {/* PAYMENT */}

                  <div className="relative">
                    <select
                      value={paymentFilter}
                      onChange={(e) =>
                        setPaymentFilter(
                          e.target.value
                        )
                      }
                      className="
                        appearance-none
                        w-full
                        sm:w-40
                        h-11
                        rounded-xl
                        border
                        border-white/[0.08]
                        bg-[#0B0F19]
                        px-4
                        pr-9
                        text-sm
                        font-medium
                        text-slate-300
                        outline-none
                        focus:border-[#F5A524]/40
                        cursor-pointer
                      "
                    >
                      <option>All Payments</option>
                      <option>COD</option>
                      <option>UPI</option>
                      <option>CARD</option>
                    </select>

                    <ChevronDown
                      size={15}
                      className="
                        absolute
                        right-3
                        top-1/2
                        -translate-y-1/2
                        text-slate-600
                        pointer-events-none
                      "
                    />
                  </div>

                  {/* EXPORT EXCEL */}

                  <button
                    type="button"
                    onClick={() => exportOrdersToExcel(orders, returnRequests)}
                    disabled={!orders.length}
                    className="inline-flex h-11 w-full sm:w-auto items-center justify-center gap-2 rounded-xl border border-emerald-500/20 bg-emerald-500/10 px-4 text-sm font-semibold text-emerald-400 transition hover:bg-emerald-500/20 hover:text-emerald-300 disabled:cursor-not-allowed disabled:opacity-50"
                    title="Export all orders, order items, and return/refund data to Excel"
                  >
                    <FileSpreadsheet size={17} />
                    Export Excel
                  </button>
                </div>
              </div>
            </div>

            {/* =================================================
                DESKTOP TABLE
            ================================================= */}
              <div className="hidden xl:block overflow-x-auto">
                <table className="w-full min-w-[1250px]">
                <thead>
                  <tr
                    className="
                      border-b
                      border-white/[0.05]
                      bg-white/[0.015]
                    "
                  >
                    <th className="px-6 py-4 text-left text-[10px] font-bold uppercase tracking-[0.12em] text-slate-500">
                      Order
                    </th>

                    <th className="px-6 py-4 text-left text-[10px] font-bold uppercase tracking-[0.12em] text-slate-500">
                      Customer
                    </th>

                    <th className="px-6 py-4 text-left text-[10px] font-bold uppercase tracking-[0.12em] text-slate-500">
                      Items
                    </th>

                    <th className="px-6 py-4 text-left text-[10px] font-bold uppercase tracking-[0.12em] text-slate-500">
                      Payment
                    </th>

                    <th className="px-6 py-4 text-left text-[10px] font-bold uppercase tracking-[0.12em] text-slate-500">
                      Total
                    </th>

                    <th className="px-6 py-4 text-left text-[10px] font-bold uppercase tracking-[0.12em] text-slate-500">
                      Status
                    </th>

                  <th
                      className="
                        px-5
                        py-4
                        text-left
                        text-[10px]
                        font-bold
                        uppercase
                        tracking-[0.12em]
                        text-slate-500
                        min-w-[150px]
                        w-[150px]
                      "
                    >
                      Date
                    </th>

                 <th
                    className="
                      px-5
                      py-4
                      text-right
                      text-[10px]
                      font-bold
                      uppercase
                      tracking-[0.12em]
                      text-slate-500
                      min-w-[120px]
                      w-[120px]
                    "
                  >
                    Action
                  </th>
                  </tr>
                </thead>

                <tbody>
                  {filteredOrders.map((order) => {
                    const customerName =
                      order.customer?.name ||
                      order.address?.full_name ||
                      "Unknown Customer";

                    const customerMobile =
                      order.customer?.mobile ||
                      order.address?.mobile ||
                      "—";

                    const itemCount =
                      order.items?.reduce(
                        (sum, item) =>
                          sum +
                          Number(
                            item.quantity || 0
                          ),
                        0
                      ) || 0;

                    return (
                      <tr
                        key={order.id}
                        className="
                          border-b
                          border-white/[0.04]
                          hover:bg-white/[0.02]
                          transition
                        "
                      >
                        {/* ORDER */}

                        <td className="px-6 py-5">
                          <div className="flex items-center gap-3">
                            <div
                              className="
                                w-10
                                h-10
                                rounded-xl
                                bg-[#F5A524]/10
                                border
                                border-[#F5A524]/15
                                text-[#F5A524]
                                flex
                                items-center
                                justify-center
                                shrink-0
                              "
                            >
                              <Box size={18} />
                            </div>

                            <div className="min-w-0">
                              <p
                                className="
                                  text-sm
                                  font-bold
                                  text-white
                                  truncate
                                  max-w-[190px]
                                "
                              >
                                {order.order_number ||
                                  `ORD-${order.id}`}
                              </p>

                              <p
                                className="
                                  text-[11px]
                                  text-slate-600
                                  mt-1
                                "
                              >
                                ID #{order.id}
                              </p>
                            </div>
                          </div>
                        </td>

                        {/* CUSTOMER */}

                        <td className="px-6 py-5">
                          <div className="min-w-[170px]">
                            <p
                              className="
                                text-sm
                                font-semibold
                                text-white
                              "
                            >
                              {customerName}
                            </p>

                            <p
                              className="
                                text-xs
                                text-slate-500
                                mt-1
                              "
                            >
                              {customerMobile}
                            </p>
                          </div>
                        </td>

                        {/* ITEMS */}

                        <td className="px-6 py-5">
                          <div className="flex items-center gap-2">
                            <div
                              className="
                                w-9
                                h-9
                                rounded-lg
                                bg-white/[0.04]
                                flex
                                items-center
                                justify-center
                                text-slate-400
                              "
                            >
                              <ShoppingBag size={16} />
                            </div>

                            <div>
                              <p
                                className="
                                  text-sm
                                  font-semibold
                                  text-slate-200
                                "
                              >
                                {itemCount} item
                                {itemCount !== 1
                                  ? "s"
                                  : ""}
                              </p>

                              <p
                                className="
                                  text-[11px]
                                  text-slate-600
                                  mt-0.5
                                "
                              >
                                {order.items?.length ||
                                  0}{" "}
                                product
                                {order.items?.length !==
                                1
                                  ? "s"
                                  : ""}
                              </p>
                            </div>
                          </div>
                        </td>

                        {/* PAYMENT */}

                        <td className="px-6 py-5">
                          <p
                            className="
                              text-sm
                              font-semibold
                              text-slate-200
                            "
                          >
                            {order.payment_method ||
                              "—"}
                          </p>

                          <p
                            className={`
                              text-[11px]
                              mt-1
                              ${
                                order.payment_status ===
                                "Paid"
                                  ? "text-emerald-400"
                                  : "text-amber-400"
                              }
                            `}
                          >
                            {order.payment_status ||
                              "Pending"}
                          </p>
                        </td>

                        {/* TOTAL */}

                        <td className="px-6 py-5">
                          <p
                            className="
                              text-sm
                              font-bold
                              text-white
                            "
                          >
                            {formatPrice(
                              order.total_amount
                            )}
                          </p>

                          <p
                            className="
                              text-[11px]
                              text-slate-600
                              mt-1
                            "
                          >
                            Order total
                          </p>
                        </td>

                        {/* STATUS */}

                        <td className="px-6 py-5">
                          <StatusBadge
                            status={
                              order.order_status
                            }
                          />
                        </td>

                        {/* DATE */}
                              <td
                                className="
                                  px-5
                                  py-5
                                  min-w-[150px]
                                  w-[150px]
                                "
                              >
                                <div
                                  className="
                                    flex
                                    items-center
                                    gap-2
                                    whitespace-nowrap
                                    text-slate-400
                                  "
                                >
                                  <CalendarDays
                                    size={16}
                                    className="shrink-0 text-slate-500"
                                  />

                                  <span className="text-xs text-slate-300">
                                    {formatDate(order.created_at)}
                                  </span>
                                </div>
                              </td>

                        {/* ACTION */}

                         <td
                            className="
                              px-5
                              py-5
                              text-right
                              min-w-[120px]
                              w-[120px]
                            "
                          >
                          <div className="flex items-center justify-end gap-1">
                            <button
                              onClick={() =>
                                setSelectedOrder(order)
                              }
                              className="
                                w-9
                                h-9
                                rounded-xl
                                border
                                border-white/[0.08]
                                bg-white/[0.02]
                                text-slate-400
                                hover:text-white
                                hover:bg-[#F5A524]/10
                                hover:border-[#F5A524]/30
                                transition
                                flex
                                items-center
                                justify-center
                              "
                              title="View order"
                            >
                              <Eye size={17} />
                            </button>

                            <ChevronRight
                              size={16}
                              className="text-slate-700"
                            />
                          </div>
                        </td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>

            {/* =================================================
                MOBILE / TABLET CARDS
            ================================================= */}

            <div
              className="
                xl:hidden
                divide-y
                divide-white/[0.05]
              "
            >
              {filteredOrders.map((order) => {
                const customerName =
                  order.customer?.name ||
                  order.address?.full_name ||
                  "Unknown Customer";

                const customerMobile =
                  order.customer?.mobile ||
                  order.address?.mobile ||
                  "—";

                const itemCount =
                  order.items?.reduce(
                    (sum, item) =>
                      sum +
                      Number(item.quantity || 0),
                    0
                  ) || 0;

                return (
                  <div
                    key={order.id}
                    className="
                      p-4
                      sm:p-5
                      hover:bg-white/[0.02]
                      transition
                    "
                  >
                    <div
                      className="
                        flex
                        items-start
                        justify-between
                        gap-3
                      "
                    >
                      <div
                        className="
                          flex
                          items-center
                          gap-3
                          min-w-0
                        "
                      >
                        <div
                          className="
                            w-10
                            h-10
                            rounded-xl
                            bg-[#F5A524]/10
                            text-[#F5A524]
                            flex
                            items-center
                            justify-center
                            shrink-0
                          "
                        >
                          <Box size={18} />
                        </div>

                        <div className="min-w-0">
                          <p
                            className="
                              text-sm
                              font-bold
                              text-white
                              truncate
                            "
                          >
                            {order.order_number ||
                              `ORD-${order.id}`}
                          </p>

                          <p
                            className="
                              text-[11px]
                              text-slate-600
                              mt-1
                            "
                          >
                            {formatDate(
                              order.created_at
                            )}
                          </p>
                        </div>
                      </div>

                      <StatusBadge
                        status={
                          order.order_status
                        }
                      />
                    </div>

                    <div
                      className="
                        grid
                        grid-cols-2
                        sm:grid-cols-4
                        gap-4
                        mt-5
                      "
                    >
                      {/* CUSTOMER */}

                      <div>
                        <p
                          className="
                            text-[10px]
                            uppercase
                            tracking-wider
                            text-slate-600
                          "
                        >
                          Customer
                        </p>

                        <p
                          className="
                            text-sm
                            font-semibold
                            text-slate-200
                            mt-1
                            truncate
                          "
                        >
                          {customerName}
                        </p>

                        <p
                          className="
                            text-[11px]
                            text-slate-600
                            mt-0.5
                          "
                        >
                          {customerMobile}
                        </p>
                      </div>

                      {/* ITEMS */}

                      <div>
                        <p
                          className="
                            text-[10px]
                            uppercase
                            tracking-wider
                            text-slate-600
                          "
                        >
                          Items
                        </p>

                        <p
                          className="
                            text-sm
                            font-semibold
                            text-slate-200
                            mt-1
                          "
                        >
                          {itemCount} items
                        </p>
                      </div>

                      {/* PAYMENT */}

                      <div>
                        <p
                          className="
                            text-[10px]
                            uppercase
                            tracking-wider
                            text-slate-600
                          "
                        >
                          Payment
                        </p>

                        <p
                          className="
                            text-sm
                            font-semibold
                            text-slate-200
                            mt-1
                          "
                        >
                          {order.payment_method ||
                            "—"}
                        </p>
                      </div>

                      {/* TOTAL */}

                      <div>
                        <p
                          className="
                            text-[10px]
                            uppercase
                            tracking-wider
                            text-slate-600
                          "
                        >
                          Total
                        </p>

                        <p
                          className="
                            text-sm
                            font-bold
                            text-white
                            mt-1
                          "
                        >
                          {formatPrice(
                            order.total_amount
                          )}
                        </p>
                      </div>
                    </div>

                    <button
                      onClick={() =>
                        setSelectedOrder(order)
                      }
                      className="
                        w-full
                        mt-5
                        h-10
                        rounded-xl
                        border
                        border-white/[0.07]
                        bg-white/[0.025]
                        text-sm
                        font-semibold
                        text-slate-300
                        hover:text-white
                        hover:bg-white/[0.05]
                        transition
                        flex
                        items-center
                        justify-center
                        gap-2
                      "
                    >
                      <Eye size={16} />
                      View Order Details
                    </button>
                  </div>
                );
              })}
            </div>

            {/* =================================================
                EMPTY STATE
            ================================================= */}

            {filteredOrders.length === 0 && (
              <div
                className="
                  py-20
                  px-6
                  text-center
                "
              >
                <div
                  className="
                    w-14
                    h-14
                    mx-auto
                    rounded-2xl
                    bg-white/[0.03]
                    border
                    border-white/[0.06]
                    flex
                    items-center
                    justify-center
                    text-slate-600
                  "
                >
                  <ShoppingBag size={24} />
                </div>

                <h3
                  className="
                    mt-4
                    text-sm
                    font-semibold
                    text-slate-300
                  "
                >
                  No orders found
                </h3>

                <p
                  className="
                    mt-1
                    text-xs
                    text-slate-600
                  "
                >
                  Try changing your search
                  or filters.
                </p>
              </div>
            )}
          </div>
        </main>

        {/* =====================================================
            RETURN REQUESTS
        ===================================================== */}

        <div className="max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-8 pb-6">
          <div className="rounded-2xl border border-white/[0.06] bg-white/[0.025] overflow-hidden">
            <div className="p-5 sm:p-6 border-b border-white/[0.06] flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
              <div>
                <h2 className="text-lg sm:text-xl font-bold text-white">Return Requests</h2>
                <p className="text-xs text-slate-500 mt-1">Manage customer returns and refunds.</p>
              </div>
              <button onClick={fetchReturnRequests} disabled={returnLoading} className="inline-flex items-center justify-center gap-2 rounded-xl border border-white/[0.08] bg-white/[0.03] px-4 py-2.5 text-sm font-semibold text-slate-300 hover:bg-white/[0.06] transition disabled:opacity-50">
                <RefreshCw size={15} className={returnLoading ? "animate-spin" : ""} />
                {returnLoading ? "Refreshing..." : "Refresh Returns"}
              </button>
            </div>

            {returnRequests.length === 0 ? (
              <div className="py-16 text-center">
                <PackageCheck size={32} className="mx-auto text-slate-700" />
                <p className="mt-3 text-sm font-semibold text-slate-400">No return requests</p>
              </div>
            ) : (
              <div className="divide-y divide-white/[0.05]">
                {returnRequests.map((returnRequest) => (
                  <div key={returnRequest.id} className="p-5 sm:p-6 hover:bg-white/[0.02] transition">
                    <div className="flex flex-col xl:flex-row xl:items-center xl:justify-between gap-5">
                      <div className="min-w-0">
                        <div className="flex flex-wrap items-center gap-3">
                          <p className="text-sm font-bold text-white">{returnRequest.order_number || `ORD-${returnRequest.order_id}`}</p>
                          <span className="rounded-lg border border-[#F5A524]/20 bg-[#F5A524]/10 px-2.5 py-1 text-xs font-semibold text-[#F5A524]">{returnRequest.status || "Requested"}</span>
                        </div>

                        <div className="mt-4 grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4">
                          <div>
                            <p className="text-[10px] uppercase tracking-wider text-slate-600">Customer</p>
                            <p className="mt-1 text-sm font-semibold text-slate-200">{returnRequest.customer_name || returnRequest.customer?.name || "Unknown Customer"}</p>
                            <p className="text-xs text-slate-500">{returnRequest.customer_mobile || returnRequest.customer?.mobile || returnRequest.address?.mobile || "—"}</p>
                          </div>
                          <div>
                            <p className="text-[10px] uppercase tracking-wider text-slate-600">Reason</p>
                            <p className="mt-1 text-sm font-semibold text-slate-200">{returnRequest.reason || "—"}</p>
                          </div>
                          <div>
                            <p className="text-[10px] uppercase tracking-wider text-slate-600">Payment</p>
                            <p className="mt-1 text-sm font-semibold text-slate-200">{returnRequest.payment_method || "—"}</p>
                          </div>
                          <div>
                            <p className="text-[10px] uppercase tracking-wider text-slate-600">Amount</p>
                            <p className="mt-1 text-sm font-bold text-white">{formatPrice(returnRequest.order_amount ?? returnRequest.total_amount)}</p>
                          </div>
                        </div>

                        {returnRequest.description && (
                          <div className="mt-4 rounded-xl border border-white/[0.05] bg-white/[0.02] p-3">
                            <p className="text-[10px] uppercase tracking-wider text-slate-600">Customer Description</p>
                            <p className="mt-1 text-sm leading-6 text-slate-400">{returnRequest.description}</p>
                          </div>
                        )}
                      </div>

                      <div className="flex flex-col sm:flex-row xl:flex-col gap-2 shrink-0">
                        {returnRequest.status === "Requested" && (
                          <>
                            <button onClick={() => handleReturnStatusUpdate(returnRequest.id, "Approved")} disabled={returnActionLoading} className="rounded-xl bg-emerald-500 px-4 py-2.5 text-sm font-bold text-white hover:bg-emerald-600 transition disabled:opacity-50">Approve</button>
                            <button onClick={() => handleReturnStatusUpdate(returnRequest.id, "Rejected")} disabled={returnActionLoading} className="rounded-xl border border-red-500/20 bg-red-500/10 px-4 py-2.5 text-sm font-bold text-red-400 hover:bg-red-500/20 transition disabled:opacity-50">Reject</button>
                          </>
                        )}

                        {returnRequest.status === "Approved" && (
                          <button onClick={() => handleProductReceived(returnRequest.id)} disabled={returnActionLoading} className="rounded-xl bg-blue-500 px-4 py-2.5 text-sm font-bold text-white hover:bg-blue-600 transition disabled:opacity-50">Product Received</button>
                        )}

                        {returnRequest.status === "Product Received" && (
                          <button onClick={() => handleRefund(returnRequest)} disabled={returnActionLoading} className="rounded-xl bg-[#F5A524] px-4 py-2.5 text-sm font-bold text-black hover:bg-[#FFB84D] transition disabled:opacity-50">Process Refund</button>
                        )}
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            )}
          </div>
        </div>

        {/* =====================================================
            ORDER DETAILS MODAL
        ===================================================== */}

        {selectedOrder && (
          <div
            className="
              fixed
              inset-0
              z-[100]
              bg-black/70
              backdrop-blur-sm
              flex
              items-center
              justify-center
              p-4
            "
            onClick={() =>
              setSelectedOrder(null)
            }
          >
            <div
              className="
                w-full
                max-w-4xl
                max-h-[92vh]
                overflow-hidden
                rounded-2xl
                border
                border-white/[0.08]
                bg-[#111722]
                shadow-2xl
              "
              onClick={(e) =>
                e.stopPropagation()
              }
            >
              {/* MODAL HEADER */}

              <div
                className="
                  px-5
                  sm:px-6
                  py-5
                  border-b
                  border-white/[0.06]
                  flex
                  items-center
                  justify-between
                  gap-4
                "
              >
                <div>
                  <p
                    className="
                      text-[10px]
                      uppercase
                      tracking-[0.15em]
                      text-[#F5A524]
                      font-bold
                    "
                  >
                    Order Details
                  </p>

                  <h2
                    className="
                      text-lg
                      sm:text-xl
                      font-bold
                      text-white
                      mt-1
                    "
                  >
                    {selectedOrder.order_number ||
                      `ORD-${selectedOrder.id}`}
                  </h2>
                </div>

                <button
                  onClick={() =>
                    setSelectedOrder(null)
                  }
                  className="
                    w-9
                    h-9
                    rounded-xl
                    bg-white/[0.04]
                    text-slate-400
                    hover:text-white
                    hover:bg-white/[0.08]
                    transition
                    flex
                    items-center
                    justify-center
                  "
                >
                  <X size={18} />
                </button>
              </div>

              {/* MODAL BODY */}

              <div
                className="
                  overflow-y-auto
                  max-h-[calc(92vh-80px)]
                  p-5
                  sm:p-6
                  space-y-5
                "
              >
                {/* CUSTOMER + PAYMENT */}

                <div
                  className="
                    grid
                    grid-cols-1
                    lg:grid-cols-2
                    gap-4
                  "
                >
                  {/* CUSTOMER */}

                  <div
                    className="
                      rounded-2xl
                      border
                      border-white/[0.06]
                      bg-white/[0.025]
                      p-5
                    "
                  >
                    <div
                      className="
                        flex
                        items-center
                        gap-2
                        mb-4
                      "
                    >
                      <User
                        size={16}
                        className="text-[#F5A524]"
                      />

                      <h3
                        className="
                          text-sm
                          font-bold
                          text-white
                        "
                      >
                        Customer
                      </h3>
                    </div>

                    <div className="space-y-3">
                      <div
                        className="
                          flex
                          items-center
                          gap-3
                        "
                      >
                        <User
                          size={15}
                          className="text-slate-600"
                        />

                        <div>
                          <p className="text-[10px] text-slate-600">
                            Name
                          </p>

                          <p className="text-sm font-semibold text-slate-200">
                            {selectedOrder.customer
                              ?.name ||
                              selectedOrder.address
                                ?.full_name ||
                              "Unknown Customer"}
                          </p>
                        </div>
                      </div>

                      <div
                        className="
                          flex
                          items-center
                          gap-3
                        "
                      >
                        <Mail
                          size={15}
                          className="text-slate-600"
                        />

                        <div>
                          <p className="text-[10px] text-slate-600">
                            Email
                          </p>

                          <p className="text-sm text-slate-300">
                            {selectedOrder.customer
                              ?.email ||
                              "—"}
                          </p>
                        </div>
                      </div>

                      <div
                        className="
                          flex
                          items-center
                          gap-3
                        "
                      >
                        <Phone
                          size={15}
                          className="text-slate-600"
                        />

                        <div>
                          <p className="text-[10px] text-slate-600">
                            Mobile
                          </p>

                          <p className="text-sm text-slate-300">
                            {selectedOrder.customer
                              ?.mobile ||
                              selectedOrder.address
                                ?.mobile ||
                              "—"}
                          </p>
                        </div>
                      </div>
                    </div>
                  </div>

                  {/* PAYMENT */}

                  <div
                    className="
                      rounded-2xl
                      border
                      border-white/[0.06]
                      bg-white/[0.025]
                      p-5
                    "
                  >
                    <div
                      className="
                        flex
                        items-center
                        gap-2
                        mb-4
                      "
                    >
                      <CreditCard
                        size={16}
                        className="text-[#F5A524]"
                      />

                      <h3
                        className="
                          text-sm
                          font-bold
                          text-white
                        "
                      >
                        Payment
                      </h3>
                    </div>

                    <div
                      className="
                        grid
                        grid-cols-2
                        gap-4
                      "
                    >
                      <div>
                        <p className="text-[10px] text-slate-600">
                          Method
                        </p>

                        <p className="text-sm font-semibold text-slate-200 mt-1">
                          {selectedOrder.payment_method ||
                            "—"}
                        </p>
                      </div>

                      <div>
                        <p className="text-[10px] text-slate-600">
                          Status
                        </p>

                        <p
                          className={`
                            text-sm
                            font-semibold
                            mt-1
                            ${
                              selectedOrder.payment_status ===
                              "Paid"
                                ? "text-emerald-400"
                                : "text-amber-400"
                            }
                          `}
                        >
                          {selectedOrder.payment_status ||
                            "Pending"}
                        </p>
                      </div>

                      <div>
                        <p className="text-[10px] text-slate-600">
                          Subtotal
                        </p>

                        <p className="text-sm font-semibold text-slate-200 mt-1">
                          {formatPrice(
                            selectedOrder.subtotal
                          )}
                        </p>
                      </div>

                      <div>
                        <p className="text-[10px] text-slate-600">
                          Shipping
                        </p>

                        <p className="text-sm font-semibold text-slate-200 mt-1">
                          {formatPrice(
                            selectedOrder.shipping_charge
                          )}
                        </p>
                      </div>
                    </div>

                    <div
                      className="
                        mt-4
                        pt-4
                        border-t
                        border-white/[0.06]
                        flex
                        items-center
                        justify-between
                      "
                    >
                      <span className="text-sm text-slate-500">
                        Grand Total
                      </span>

                      <span className="text-lg font-bold text-white">
                        {formatPrice(
                          selectedOrder.total_amount
                        )}
                      </span>
                    </div>
                  </div>
                </div>

                {/* ADDRESS */}

                <div
                  className="
                    rounded-2xl
                    border
                    border-white/[0.06]
                    bg-white/[0.025]
                    p-5
                  "
                >
                  <div
                    className="
                      flex
                      items-center
                      gap-2
                      mb-4
                    "
                  >
                    <MapPin
                      size={16}
                      className="text-[#F5A524]"
                    />

                    <h3
                      className="
                        text-sm
                        font-bold
                        text-white
                      "
                    >
                      Delivery Address
                    </h3>
                  </div>

                  <div
                    className="
                      grid
                      grid-cols-1
                      sm:grid-cols-2
                      gap-4
                    "
                  >
                    <div>
                      <p className="text-[10px] text-slate-600">
                        Name
                      </p>

                      <p className="text-sm text-slate-300 mt-1">
                        {selectedOrder.address
                          ?.full_name ||
                          "—"}
                      </p>
                    </div>

                    <div>
                      <p className="text-[10px] text-slate-600">
                        Mobile
                      </p>

                      <p className="text-sm text-slate-300 mt-1">
                        {selectedOrder.address
                          ?.mobile ||
                          "—"}
                      </p>
                    </div>

                    <div className="sm:col-span-2">
                      <p className="text-[10px] text-slate-600">
                        Address
                      </p>

                      <p className="text-sm text-slate-300 mt-1 leading-6">
                        {selectedOrder.address
                          ?.house || ""}

                        {selectedOrder.address
                          ?.area
                          ? `, ${selectedOrder.address.area}`
                          : ""}

                        {selectedOrder.address
                          ?.city
                          ? `, ${selectedOrder.address.city}`
                          : ""}

                        {selectedOrder.address
                          ?.state
                          ? `, ${selectedOrder.address.state}`
                          : ""}

                        {selectedOrder.address
                          ?.pincode
                          ? ` - ${selectedOrder.address.pincode}`
                          : ""}
                      </p>
                    </div>
                  </div>
                </div>

                {/* ITEMS */}

                <div
                  className="
                    rounded-2xl
                    border
                    border-white/[0.06]
                    bg-white/[0.025]
                    overflow-hidden
                  "
                >
                  <div
                    className="
                      px-5
                      py-4
                      border-b
                      border-white/[0.06]
                    "
                  >
                    <div
                      className="
                        flex
                        items-center
                        gap-2
                      "
                    >
                      <Box
                        size={16}
                        className="text-[#F5A524]"
                      />

                      <h3
                        className="
                          text-sm
                          font-bold
                          text-white
                        "
                      >
                        Order Items
                      </h3>
                    </div>
                  </div>

                  <div>
                    {selectedOrder.items?.map(
                      (item) => (
                        <div
                          key={item.id}
                          className="
                            p-4
                            border-b
                            border-white/[0.04]
                            last:border-b-0
                            flex
                            items-center
                            gap-4
                          "
                        >
                          {/* IMAGE */}

                          <div
                            className="
                              w-14
                              h-14
                              rounded-xl
                              bg-white/[0.04]
                              border
                              border-white/[0.06]
                              overflow-hidden
                              shrink-0
                            "
                          >
                            {item.image ? (
                              <img
                                src={item.image}
                                alt={
                                  item.product_name ||
                                  "Product"
                                }
                                className="
                                  w-full
                                  h-full
                                  object-cover
                                "
                              />
                            ) : (
                              <div
                                className="
                                  w-full
                                  h-full
                                  flex
                                  items-center
                                  justify-center
                                  text-slate-700
                                "
                              >
                                <Box size={20} />
                              </div>
                            )}
                          </div>

                          {/* PRODUCT */}

                          <div className="flex-1 min-w-0">
                            <p
                              className="
                                text-sm
                                font-semibold
                                text-white
                                truncate
                              "
                            >
                              {item.product_name ||
                                "Product"}
                            </p>

                            <div
                              className="
                                flex
                                flex-wrap
                                items-center
                                gap-3
                                mt-1
                              "
                            >
                              {item.size && (
                                <span className="text-xs text-slate-500">
                                  Size:{" "}
                                  <span className="text-slate-300">
                                    {item.size}
                                  </span>
                                </span>
                              )}

                              <span className="text-xs text-slate-500">
                                Qty:{" "}
                                <span className="text-slate-300">
                                  {item.quantity}
                                </span>
                              </span>

                              <span className="text-xs text-slate-500">
                                Price:{" "}
                                <span className="text-slate-300">
                                  {formatPrice(
                                    item.price
                                  )}
                                </span>
                              </span>
                            </div>
                          </div>

                          {/* ITEM TOTAL */}

                          <div className="text-right">
                            <p
                              className="
                                text-sm
                                font-bold
                                text-white
                              "
                            >
                              {formatPrice(
                                item.total
                              )}
                            </p>
                          </div>
                        </div>
                      )
                    )}
                  </div>
                </div>

                {/* ORDER INFORMATION */}

                <div
                  className="
                    grid
                    grid-cols-1
                    sm:grid-cols-3
                    gap-4
                  "
                >
                  {/* ORDER ID */}

                  <div
                    className="
                      rounded-xl
                      border
                      border-white/[0.06]
                      bg-white/[0.02]
                      p-4
                    "
                  >
                    <div className="flex items-center gap-2">
                      <Hash
                        size={15}
                        className="text-slate-600"
                      />

                      <p className="text-[10px] text-slate-600 uppercase">
                        Order ID
                      </p>
                    </div>

                    <p className="text-sm font-semibold text-slate-300 mt-2">
                      #{selectedOrder.id}
                    </p>
                  </div>

                  {/* CREATED */}

                  <div
                    className="
                      rounded-xl
                      border
                      border-white/[0.06]
                      bg-white/[0.02]
                      p-4
                    "
                  >
                    <div className="flex items-center gap-2">
                      <CalendarDays
                        size={15}
                        className="text-slate-600"
                      />

                      <p className="text-[10px] text-slate-600 uppercase">
                        Created
                      </p>
                    </div>

                    <p className="text-sm font-semibold text-slate-300 mt-2">
                      {formatDateTime(
                        selectedOrder.created_at
                      )}
                    </p>
                  </div>

                  {/* UPDATED */}

                  <div
                    className="
                      rounded-xl
                      border
                      border-white/[0.06]
                      bg-white/[0.02]
                      p-4
                    "
                  >
                    <div className="flex items-center gap-2">
                      <Clock3
                        size={15}
                        className="text-slate-600"
                      />

                      <p className="text-[10px] text-slate-600 uppercase">
                        Updated
                      </p>
                    </div>

                    <p className="text-sm font-semibold text-slate-300 mt-2">
                      {formatDateTime(
                        selectedOrder.updated_at
                      )}
                    </p>
                  </div>
                </div>

                {/* STATUS UPDATE */}

                <div
                  className="
                    rounded-2xl
                    border
                    border-[#F5A524]/10
                    bg-[#F5A524]/[0.025]
                    p-5
                  "
                >
                  <div
                    className="
                      flex
                      flex-col
                      sm:flex-row
                      sm:items-center
                      sm:justify-between
                      gap-4
                    "
                  >
                    <div>
                      <p
                        className="
                          text-sm
                          font-bold
                          text-white
                        "
                      >
                        Update Order Status
                      </p>

                      <p
                        className="
                          text-xs
                          text-slate-600
                          mt-1
                        "
                      >
                        Change the delivery
                        progress of this order.
                      </p>
                    </div>

                    <div className="relative">
                      <select
                        value={
                          selectedOrder.order_status ||
                          "Pending"
                        }
                        disabled={updatingStatus}
                        onChange={(e) =>
                          handleStatusUpdate(
                            selectedOrder.id,
                            e.target.value
                          )
                        }
                        className="
                          appearance-none
                          h-11
                          min-w-[180px]
                          rounded-xl
                          border
                          border-white/[0.08]
                          bg-[#0B0F19]
                          px-4
                          pr-10
                          text-sm
                          font-semibold
                          text-slate-300
                          outline-none
                          focus:border-[#F5A524]/40
                          disabled:opacity-50
                          cursor-pointer
                        "
                      >
                        <option>Pending</option>
                        <option>Confirmed</option>
                        <option>Shipped</option>
                        <option>Out for Delivery</option>
                        <option>Delivered</option>
                        <option>Cancelled</option>
                      </select>

                      {updatingStatus ? (
                        <Loader2
                          size={16}
                          className="
                            absolute
                            right-3
                            top-1/2
                            -translate-y-1/2
                            text-[#F5A524]
                            animate-spin
                            pointer-events-none
                          "
                        />
                      ) : (
                        <ChevronDown
                          size={16}
                          className="
                            absolute
                            right-3
                            top-1/2
                            -translate-y-1/2
                            text-slate-600
                            pointer-events-none
                          "
                        />
                      )}
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        )}
      </div>
    </AdminLayout>
  );
}
